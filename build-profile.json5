{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.0.2(22)",
        "compatibleSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "common",
      "srcPath": "./common"
    },
    {
      "name": "editor",
      "srcPath": "./features/editor"
    },
    {
      "name": "material",
      "srcPath": "./features/material"
    },
    {
      "name": "relationship",
      "srcPath": "./features/relationship"
    },
    {
      "name": "agent",
      "srcPath": "./features/agent"
    },
    {
      "name": "settings",
      "srcPath": "./features/settings"
    },
    {
      "name": "entry",
      "srcPath": "./products/default",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
